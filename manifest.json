{
  "manifest_version": 3,
  "name": "Blue Bridge",
  "version": "0.4.0",
  "description": "Translate text, selected text, and live webpage content.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Blue Bridge Translator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Open Blue Bridge"
    },
    "translate-page": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Translate the current webpage"
    },
    "restore-page": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Restore the original webpage"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Translate selected text"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
